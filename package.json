{
  "name": "eos-enemy-of-swag",
  "version": "1.0.0",
  "private": true,
  "description": "EOS (Enemy of Swag) storefront and admin. Plain JS + CSS, Node/Express, Shopify Admin GraphQL as the source of truth.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "check": "node --check server/index.js",
    "build:js": "esbuild public/js/main.js --bundle --splitting --format=esm --target=safari13,ios13 --minify --sourcemap --outdir=public/js/app --entry-names=[name] --chunk-names=c-[hash]"
  },
  "engines": {
    "node": ">=20.12"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "compression": "^1.8.0",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
