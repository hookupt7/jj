# Copy to .env for local development. Never commit the real .env.

# Shopify store (the myshopify.com domain, no https://)
SHOPIFY_STORE_DOMAIN=d5gdhb-up.myshopify.com

# Dev Dashboard app "EOS Site" -> Settings -> Client ID / Client secret.
# The server exchanges these for an Admin API access token (client credentials grant),
# caches it in memory and refreshes it before it expires (and on any 401).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Admin GraphQL API version
SHOPIFY_API_VERSION=2026-10

# Password for /admin (long and unique). Changing it signs every admin session out.
ADMIN_PASSWORD=

# Random string used to sign the admin session cookie (32+ chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# WhatsApp number in international format, digits only
WHATSAPP_NUMBER=2349122318512

# Checkout mode: "draft_order" (default: Draft Order + confirm on WhatsApp)
# or "shopify" (real Shopify checkout via Storefront API cartCreate -> checkoutUrl).
CHECKOUT_MODE=draft_order
# Optional in shopify mode: a Storefront API token. If empty, the server mints one
# with storefrontAccessTokenCreate (uses the app's unauthenticated_* scopes).
SHOPIFY_STOREFRONT_TOKEN=

# Optional: public URL of the site (canonical links + sitemap), e.g. https://eos.onrender.com
PUBLIC_URL=

PORT=3000
